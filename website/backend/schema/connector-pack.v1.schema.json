{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dimnuo.com/marketplace/schema/connector-pack.v1.schema.json",
  "title": "Connector Pack v1",
  "type": "object",
  "required": ["id", "kind", "name", "connector"],
  "additionalProperties": true,
  "properties": {
    "spec_version": { "type": "integer", "minimum": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/connector/[a-z0-9][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
    },
    "kind": { "const": "connector" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "platform_compat": {
      "type": "object",
      "properties": {
        "common": { "type": "boolean" },
        "surfaces": {
          "type": "array",
          "items": { "enum": ["web", "desktop"] }
        },
        "desktop_os": {
          "type": "array",
          "items": { "enum": ["windows", "macos", "linux"] }
        }
      }
    },
    "requires_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "connector": {
      "type": "object",
      "required": ["id", "name", "transport"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "type": "string", "default": "mcp" },
        "transport": { "enum": ["stdio", "sse", "http"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "auth": {
          "type": "object",
          "properties": {
            "method": { "enum": ["none", "api_key", "token", "oauth2"] },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string" },
                  "secret": { "type": "boolean" },
                  "placeholder": { "type": "string" }
                }
              }
            }
          }
        },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
