{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpisci.dev/schema/expert-pack.v1.json",
  "title": "Pisci Expert Pack v1",
  "type": "object",
  "required": ["spec_version", "id", "name", "description", "system_prompt"],
  "properties": {
    "spec_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/expert/[a-z0-9-]+@\\d+\\.\\d+\\.\\d+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "system_prompt": { "type": "string", "minLength": 1 },
    "icon": { "type": "string" },
    "color": { "type": "string" }
  }
}
