{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpisci.dev/schema/team-template.v2.json",
  "title": "Pisci Team Template v2",
  "description": "Self-contained team pack. Members embed expert snapshots (copy model) so teams work offline after install.",
  "type": "object",
  "required": ["spec_version", "id", "name", "description", "members"],
  "properties": {
    "spec_version": { "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/team/[a-z0-9-]+@\\d+\\.\\d+\\.\\d+$",
      "description": "Global asset id: publisher/team/slug@semver"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "org_spec": { "type": "string", "description": "Optional pool org_spec markdown override" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/teamMember" }
    },
    "roles": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Deprecated v1 field; derived from members[].role"
    }
  },
  "$defs": {
    "teamMember": {
      "type": "object",
      "required": ["member_id", "role", "name", "system_prompt"],
      "properties": {
        "member_id": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "system_prompt": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "source_id": {
          "type": "string",
          "description": "Global expert asset id this snapshot was copied from"
        },
        "source_version": {
          "type": "string",
          "description": "Semver of source at copy time; compare for manual upgrades"
        }
      }
    }
  }
}
